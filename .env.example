# --- SAP Cloud ALM MCP server configuration ---

# =============================================================================
# Option A: OAuth2 (recommended) — HTTP transport only
# =============================================================================
# Register an OAuth client in SAP BTP and set these vars.
# The server will proxy all MCP client authentication through SAP BTP XSUAA.
# Tokens are refreshed automatically — no manual copy-paste needed.
#
# Find these in your SAP BTP subaccount → Security → OAuth Clients.
#
# CALM_OAUTH_CLIENT_ID=<your-btp-oauth-client-id>
# CALM_OAUTH_CLIENT_SECRET=<your-btp-oauth-client-secret>
#
# SAP BTP XSUAA endpoints (replace <subdomain> and <region>):
# CALM_OAUTH_AUTH_URL=https://<subdomain>.authentication.<region>.hana.ondemand.com/oauth/authorize
# CALM_OAUTH_TOKEN_URL=https://<subdomain>.authentication.<region>.hana.ondemand.com/oauth/token
# CALM_OAUTH_JWKS_URI=https://<subdomain>.authentication.<region>.hana.ondemand.com/token_keys
# CALM_OAUTH_ISSUER=https://<subdomain>.authentication.<region>.hana.ondemand.com/oauth/token
#
# Optional: override the token audience (defaults to CALM_OAUTH_CLIENT_ID)
# CALM_OAUTH_AUDIENCE=<audience>
#
# Optional: SAP scopes to request (space-separated)
# CALM_OAUTH_SCOPES=openid profile email
#
# Public URL of this MCP server (used for OAuth callback):
# MCP_BASE_URL=https://your-mcp-server.example.com


# =============================================================================
# Option B: Bearer token header (legacy HTTP) — no OAuth
# =============================================================================
# Pass x-calm-token (and optionally x-calm-base-url) as HTTP request headers
# per-request. The server is stateless — credentials come per-request.
# No config needed here; the header is read at runtime.


# =============================================================================
# Option C: Static token (local dev / stdio)
# =============================================================================
# Set CALM_TOKEN for stdio transport (Claude Desktop, MCP Inspector, Cursor).
# Falls back to this when neither OAuth nor x-calm-token header is present.
#
# CALM_TOKEN=paste-your-bearer-token-here


# =============================================================================
# Common settings
# =============================================================================

# Override the CALM tenant base URL (optional).
# Defaults to the illumiti-corp-cloudalm tenant.
# CALM_BASE_URL=https://<tenant>.<region>.alm.cloud.sap

# Optional logging level
# LOG_LEVEL=INFO

# Optional HTTP transport host/port (only used with --http)
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
