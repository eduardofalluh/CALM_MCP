# --- SAP Cloud ALM MCP server configuration ---
#
# Two separate SAP URLs are involved:
#   Auth URL → https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
#   API  URL → https://<tenant>.<region>.alm.cloud.sap/api/...


# =============================================================================
# Option A: Client Credentials (recommended for production)
# =============================================================================
# The server calls SAP XSUAA with Basic Auth (Base64 client_id:client_secret)
# and caches the access token automatically.  Tokens are refreshed before
# expiry — no manual copy-paste ever needed.
#
# Get these from your SAP BTP subaccount → Security → OAuth Clients.
# For Syntax GenAI Studio deployment, set these as deployment environment
# variables/secrets on the MCP server.
#
# Preferred: set tenant pieces from the BTP configuration. The server derives:
#   CALM_AUTH_URL=https://<identity-zone>.authentication.<region-zone>.hana.ondemand.com/oauth/token
#   CALM_BASE_URL=https://<identity-zone>.<region-zone>.alm.cloud.sap
#
# IDENTITY_ZONE=<your-btp-identity-zone>
# REGION_ZONE=<your-btp-region-zone>
#
# Optional: explicit URL overrides if your deployment needs them.
# CALM_BASE_URL=https://<tenant>.<region>.alm.cloud.sap
# CALM_AUTH_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
# CALM_CLIENT_ID=<your-oauth-client-id>
# CALM_CLIENT_SECRET=<your-oauth-client-secret>
#
# --- x509 / mTLS service keys (credential-type: x509) ---
# If your BTP service key is certificate-based (no clientsecret), set the client
# certificate instead of the secret. The server then authenticates via mTLS to the
# '.cert.' XSUAA host. Provide EITHER file paths OR inline PEM:
#   CALM_CLIENT_ID=<clientid from the x509 service key>
#   CALM_CLIENT_CERT=/path/to/cert.pem        # or a combined cert+key PEM
#   CALM_CLIENT_KEY=/path/to/key.pem
#   # ...or inline (useful for GenAI Studio secrets):
#   CALM_CLIENT_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#   CALM_CLIENT_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# The cert token host is derived automatically; override with CALM_CERT_AUTH_URL.
#
# If both the zone variables and explicit URLs are omitted, the server defaults
# to the illumiti-corp-cloudalm eu10 tenant.


# =============================================================================
# Option B: Bearer token header (legacy HTTP)
# =============================================================================
# Pass Authorization: Bearer <token> (and optionally x-calm-base-url) as HTTP
# request headers per-request. No config needed here; the header is read at runtime.


# =============================================================================
# Option C: Static token (local dev / stdio)
# =============================================================================
# CALM_TOKEN=paste-your-bearer-token-here


# =============================================================================
# Common settings
# =============================================================================

# Override the CALM tenant API base URL (optional).
# Prefer IDENTITY_ZONE + REGION_ZONE unless you need a custom URL.
# CALM_BASE_URL=https://illumiti-corp-cloudalm.eu10.alm.cloud.sap

# Optional logging level
# LOG_LEVEL=INFO

# =============================================================================
# Write Operations Safety Guard (REQUIRED for create/update/delete)
# =============================================================================
# Write tools (38 total: create_*/update_*/delete_* for tasks, projects,
# processes, scopes, test cases) are DISABLED by default as a safety guard.
#
# To enable write operations, uncomment and set to true:
# CALM_ENABLE_WRITES=true
#
# Your OAuth scopes must include .write and .delete authorities for the
# entities you want to modify. When this is disabled (default), the server
# is read-only and nothing can accidentally change the tenant.
#
# =============================================================================
# User Email for Audit Logging (OPTIONAL)
# =============================================================================
# When set, all write operations will include this email in CALM audit logs
# instead of showing "System Action". This helps track who created/updated/deleted
# items via the MCP server.
#
# CALM_USER_EMAIL=user@company.com
#
# For GenAI Studio deployments, the user email should be injected via the
# X-User-Email request header ({{user.email}}) instead of using this env var.
# This env var serves as a fallback when no header is provided.
#
# See ENABLING_WRITE_OPERATIONS.md for detailed instructions.
# CALM_ENABLE_WRITES=true

# Optional HTTP transport host/port (only used with --http).
# Use MCP_HOST=0.0.0.0 for hosted/container deployments.
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
