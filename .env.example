# --- SAP Cloud ALM MCP server configuration ---

# Option 1 (recommended for local dev): paste a bearer token directly.
# This is what your AI team meant by "create a local token for the moment".
CALM_TOKEN=paste-your-bearer-token-here

# Option 2 (later, for production-style auth): leave CALM_TOKEN unset and
# provide the base64-encoded "client_id:client_secret" used in the original
# get_calm_token() function. The server will fetch a fresh access token
# automatically on each call.
# CALM_BASIC_AUTH=

# Override the CALM tenant base URL when targeting a different client.
# CALM_BASE_URL=https://illumiti-corp-cloudalm.eu10.alm.cloud.sap

# Override the OAuth2 token endpoint to match the tenant above.
# CALM_AUTH_URL=https://illumiti-corp-cloudalm.authentication.eu10.hana.ondemand.com/oauth/token?grant_type=client_credentials

# Optional logging level
# LOG_LEVEL=INFO

# Optional HTTP transport host/port (only used with --http)
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
